# Copy to .env (git-ignored) or run `npm run create-wallet` to generate it.
# Never commit the real .env.

# Private key of the test-only deployer wallet (0x + 64 hex characters).
BSC_TESTNET_PRIVATE_KEY=

# BSC Testnet RPC endpoint (chain ID 97).
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# Public address of the deployer wallet (paste this into the faucet).
DEPLOYER_ADDRESS=
