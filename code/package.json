{
  "name": "tokenize-art-code",
  "version": "0.1.0",
  "private": true,
  "description": "TokenizeArt: BEP-721 NFT contract code (BSC Testnet)",
  "type": "module",
  "scripts": {
    "build": "hardhat build",
    "test": "hardhat test",
    "deploy": "hardhat run ../deployment/deploy.ts --network bscTestnet",
    "deploy:local": "hardhat run ../deployment/deploy.ts",
    "mint": "hardhat run ../deployment/mint.ts --network bscTestnet",
    "demo": "hardhat test && node ../deployment/show-nft.ts",
    "show-nft": "node ../deployment/show-nft.ts",
    "generate-art": "node scripts/generate-art.ts",
    "upload-to-ipfs": "node scripts/upload-to-ipfs.ts",
    "create-wallet": "node scripts/create-wallet.ts",
    "check-deployer": "hardhat run scripts/check-deployer.ts --network bscTestnet"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.2.1",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "^3.0.13",
    "@nomicfoundation/hardhat-ignition": "^3.1.9",
    "@nomicfoundation/hardhat-ignition-ethers": "^3.1.6",
    "@nomicfoundation/hardhat-keystore": "^3.1.2",
    "@nomicfoundation/hardhat-mocha": "^4.0.1",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.12",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^4.0.0",
    "@nomicfoundation/hardhat-typechain": "^3.1.3",
    "@nomicfoundation/hardhat-verify": "^3.1.4",
    "@nomicfoundation/ignition-core": "^3.1.11",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "chai": "^6.3.0",
    "ethers": "^6.17.0",
    "hardhat": "^3.21.1",
    "mocha": "^12.0.3",
    "sharp": "^0.34.5",
    "typescript": "~5.8"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1"
  }
}
